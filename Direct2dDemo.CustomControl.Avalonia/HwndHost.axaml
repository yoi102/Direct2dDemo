<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="root"
             xmlns:local="clr-namespace:Direct2dDemo.CustomControl.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Direct2dDemo.CustomControl.Avalonia.HwndHost">
    <Border BorderThickness="1"
            BorderBrush="Gray">
        <local:Win32DrawingHost Margin="1.5"
                                DrawingContext="{Binding DrawingContext, ElementName=root}" />
    </Border>
</UserControl>
